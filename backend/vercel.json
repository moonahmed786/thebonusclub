{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    { "path": "/api/v1/cron/expire-vouchers", "schedule": "*/15 * * * *" },
    { "path": "/api/v1/cron/membership-expiry-alerts", "schedule": "0 9 * * *" }
  ]
}
