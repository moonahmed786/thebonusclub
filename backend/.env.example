# Copy to .env (local) or set in Vercel Project Settings. Never commit real values.
NODE_ENV=development
PORT=3000

# PostgreSQL. DATABASE_URL must be the pooled URL in production (Neon pooler / Supabase PgBouncer).
DATABASE_URL=postgresql://bonusclub:bonusclub@localhost:5432/bonusclub
# Direct (non-pooled) URL used only for migrations.
DIRECT_DATABASE_URL=postgresql://bonusclub:bonusclub@localhost:5432/bonusclub

# MongoDB Atlas (audit trail)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bonusclub

# Auth. JWT_SECRET must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=change-me

# Business rules
VOUCHER_CLAIM_LIMIT_PER_OFFER=1
VOUCHER_DEFAULT_VALIDITY_DAYS=30
VERIFICATION_CODE_TTL_SECONDS=300
# Open decision (CLAUDE.md §8.4): near-expiry alert window
MEMBERSHIP_EXPIRY_ALERT_DAYS=7

# Rate limits (requests per window)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_VOUCHER_CLAIM=20
RATE_LIMIT_CODE_VERIFY=30

# Swagger UI at /api-docs. Defaults to off in production (exposes admin routes).
SWAGGER_ENABLED=true

# Push notifications (FCM). Off by default; never enable against real users without approval.
NOTIFICATIONS_ENABLED=false
# Base64-encoded Firebase service account JSON
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Seed (prisma/seed.ts)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Monthly plan price is not in the PRD; the monthly plan is only seeded when this is set.
SEED_MONTHLY_PLAN_PRICE_CENTS=
