generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MEMBER
  ADMIN

  @@map("user_role")
}

enum MemberStatus {
  INACTIVE
  ACTIVE

  @@map("member_status")
}

enum VoucherStatus {
  CLAIMED
  REDEEMED
  EXPIRED

  @@map("voucher_status")
}

enum DevicePlatform {
  IOS
  ANDROID

  @@map("device_platform")
}

model Plan {
  id                    String         @id @default(uuid()) @db.Uuid
  code                  String         @unique
  name                  String
  priceCents            Int            @map("price_cents")
  registrationFeeCents  Int            @default(0) @map("registration_fee_cents")
  durationMonths        Int            @map("duration_months")
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at")
  users                 User[]
  subscriptions         Subscription[]

  @@map("plans")
}

model User {
  id                String         @id @default(uuid()) @db.Uuid
  // Generated by a database sequence (BC- + digits); never reused.
  memberId          String         @unique @default(dbgenerated("('BC-'::text || nextval('member_id_seq'::regclass))")) @map("member_id")
  email             String         @unique
  passwordHash      String         @map("password_hash")
  role              UserRole       @default(MEMBER)
  status            MemberStatus   @default(INACTIVE)
  firstName         String?        @map("first_name")
  lastName          String?        @map("last_name")
  phone             String?
  address           String?
  birthday          DateTime?      @db.Date
  planId            String?        @map("plan_id") @db.Uuid
  plan              Plan?          @relation(fields: [planId], references: [id])
  activatedAt       DateTime?      @map("activated_at")
  expiresAt         DateTime?      @map("expires_at")
  expiryAlertSentAt DateTime?      @map("expiry_alert_sent_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  subscriptions        Subscription[]     @relation("SubscriptionMember")
  activationsPerformed Subscription[]     @relation("SubscriptionActivatedBy")
  vouchers             Voucher[]
  verificationCodes    VerificationCode[]
  devices              Device[]

  @@index([status, expiresAt])
  @@map("users")
}

model Subscription {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  user          User      @relation("SubscriptionMember", fields: [userId], references: [id])
  planId        String    @map("plan_id") @db.Uuid
  plan          Plan      @relation(fields: [planId], references: [id])
  startsAt      DateTime  @map("starts_at")
  expiresAt     DateTime  @map("expires_at")
  activatedById String    @map("activated_by_id") @db.Uuid
  activatedBy   User      @relation("SubscriptionActivatedBy", fields: [activatedById], references: [id])
  createdAt     DateTime  @default(now()) @map("created_at")
  payment       Payment?

  @@index([userId])
  @@map("subscriptions")
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  subscriptionId String       @unique @map("subscription_id") @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  // Off-system payment reference only. No card or bank details are ever stored.
  reference      String       @unique
  amountCents    Int          @map("amount_cents")
  currency       String       @default("USD")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("payments")
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  slug      String    @unique
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  partners  Partner[]

  @@map("categories")
}

model Partner {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  categoryId       String    @map("category_id") @db.Uuid
  category         Category  @relation(fields: [categoryId], references: [id])
  description      String?
  logoUrl          String?   @map("logo_url")
  address          String?
  phone            String?
  email            String?
  website          String?
  redemptionMethod String    @map("redemption_method")
  isActive         Boolean   @default(true) @map("is_active")
  // SHA-256 of the partner POS API key; the key itself is shown once on creation.
  apiKeyHash       String?   @unique @map("api_key_hash")
  apiKeyPrefix     String?   @map("api_key_prefix")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  offers           Offer[]
  vouchers         Voucher[]

  @@index([categoryId, isActive])
  @@map("partners")
}

model Offer {
  id                  String    @id @default(uuid()) @db.Uuid
  partnerId           String    @map("partner_id") @db.Uuid
  partner             Partner   @relation(fields: [partnerId], references: [id])
  title               String
  description         String?
  terms               String?
  startsAt            DateTime  @map("starts_at")
  endsAt              DateTime? @map("ends_at")
  isPaused            Boolean   @default(false) @map("is_paused")
  voucherValidityDays Int?      @map("voucher_validity_days")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  vouchers            Voucher[]

  @@index([partnerId])
  @@map("offers")
}

model Voucher {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @map("user_id") @db.Uuid
  user                  User          @relation(fields: [userId], references: [id])
  offerId               String        @map("offer_id") @db.Uuid
  offer                 Offer         @relation(fields: [offerId], references: [id])
  partnerId             String        @map("partner_id") @db.Uuid
  partner               Partner       @relation(fields: [partnerId], references: [id])
  // SHA-256 of the normalized code. The plain code is returned to the member once.
  codeHash              String        @unique @map("code_hash")
  codeLast4             String        @map("code_last4")
  status                VoucherStatus @default(CLAIMED)
  claimedAt             DateTime      @default(now()) @map("claimed_at")
  expiresAt             DateTime      @map("expires_at")
  redeemedAt            DateTime?     @map("redeemed_at")
  redemptionAmountCents Int?          @map("redemption_amount_cents")
  expiredAt             DateTime?     @map("expired_at")

  @@index([userId, offerId, status])
  @@index([status, expiresAt])
  @@map("vouchers")
}

model VerificationCode {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  user               User      @relation(fields: [userId], references: [id])
  codeHash           String    @unique @map("code_hash")
  expiresAt          DateTime  @map("expires_at")
  usedAt             DateTime? @map("used_at")
  usedByPartnerId    String?   @map("used_by_partner_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("verification_codes")
}

model Device {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id])
  fcmToken   String         @unique @map("fcm_token")
  platform   DevicePlatform
  createdAt  DateTime       @default(now()) @map("created_at")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at")

  @@index([userId])
  @@map("devices")
}
